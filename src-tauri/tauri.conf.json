{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Succes Donjons",
  "version": "0.1.0",
  "identifier": "fr.axel.succes-donjons",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Succès Donjons",
        "width": 380,
        "height": 700,
        "minWidth": 280,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
